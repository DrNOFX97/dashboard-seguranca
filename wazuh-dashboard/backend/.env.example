# Configuração de ligação ao Wazuh
# Copiar para .env e preencher com os valores reais do teu laboratório

# Manager API (gestão de agentes) — porta 55000
WAZUH_MANAGER_URL=https://192.168.1.150:55000
WAZUH_MANAGER_USER=wazuh-wui
WAZUH_MANAGER_PASSWORD=coloca_aqui_a_password_do_wazuh-passwords.txt

# Indexer API (alertas) — porta 9200
WAZUH_INDEXER_URL=https://192.168.1.150:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=coloca_aqui_a_password_do_wazuh-passwords.txt

# AIhubmix — gateway OpenAI-compatible (docs.aihubmix.com), usado por
# POST /api/alerts/explain para gerar explicações de alertas em PT-PT.
# Opcional: sem esta chave, o endpoint devolve 503 em vez de falhar.
AIHUBMIX_API_KEY=coloca_aqui_a_tua_chave
AIHUBMIX_MODEL=auto
